# Django
DJANGO_SECRET_KEY=replace-this-with-a-new-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Internal AI service
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_TIMEOUT=30

# Email / SMTP
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-google-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com

# Frontend URLs used in account emails
EMAIL_VERIFICATION_URL=http://localhost:5173/verify-email/?uid={uid}&token={token}
PASSWORD_RESET_URL=http://localhost:5173/reset-password/?uid={uid}&token={token}
